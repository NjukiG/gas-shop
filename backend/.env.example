# Gas-Shop backend configuration template.
# Copy this file to .env for local development and fill in real values.
# In the cloud (ECS/EKS), these are injected as environment variables
# (typically from AWS Secrets Manager / SSM) and no .env file is used.

# PostgreSQL connection string (GORM/pgx DSN). Required.
# Example (local): host=localhost user=postgres password=postgres dbname=gas-shop port=5432 sslmode=disable TimeZone=UTC
DB_URL=

# Secret used to sign authentication (JWT) tokens. Required.
# Generate a strong random value; never reuse across environments.
SECRET=

# Port the HTTP server listens on. Optional (defaults to 3000).
PORT=3000

# Comma-separated list of origins allowed by CORS. Optional.
# Defaults to the local Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173
